# Dockerfile para rustdesk-server (hbbs/hbbr)
FROM rust:1.78-slim-bookworm as builder

WORKDIR /usr/src/rustdesk-server

# 1. Copiamos el código del repositorio rustdesk-server
COPY . .

# 2. Compilamos los binarios. 
# NOTA: En este repo SÍ existen hbbs y hbbr.
RUN cargo build --release --bin hbbs --bin hbbr

# ETAPA 2: RUNTIME
FROM debian:bookworm-slim
WORKDIR /opt/rustdesk

# Instalar dependencias mínimas para tiempo de ejecución (TLS, etc)
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

# Copiamos los binarios compilados
COPY --from=builder /usr/src/rustdesk-server/target/release/hbbs .
COPY --from=builder /usr/src/rustdesk-server/target/release/hbbr .

# Puertos necesarios
EXPOSE 21115 21116 21116/udp 21117 21118 21119

# Script de inicio o comando por defecto
CMD ["./hbbs"]